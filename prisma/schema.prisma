// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Menfess {
  id                         String                @id @default(uuid())
  to                         String
  from                       String
  message                    String
  tweetId                    String?               @unique
  fingerprint                String?
  ipAddressHash              String?
  isBlocked                  Boolean               @default(false)
  isPosted                   Boolean               @default(false)
  resourceUserId             String?
  resourceUsername           String?
  resourceName               String?
  resourceEmail              String?
  resourceNpm                String?
  resourceOrganizationalCode String?
  ssoUsername                String?
  ssoName                    String?
  ssoNpm                     String?
  ssoOrganizationalCode      String?
  approvalStatus             MenfessApprovalStatus @default(APPROVED)
  createdAt                  DateTime              @default(now())
  reactions                  Reaction[]
  comments                   Comment[]

  @@index([fingerprint])
  @@index([ipAddressHash])
  @@index([resourceUserId])
  @@index([approvalStatus, createdAt])
}

enum MenfessApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model BannedFingerprint {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  reason      String?
  createdAt   DateTime @default(now())
}

model BannedSsoIdentity {
  id           String   @id @default(cuid())
  identityHash String   @unique
  reason       String?
  createdAt    DateTime @default(now())
}

model BannedIpAddress {
  id        String   @id @default(cuid())
  ipHash    String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model Reaction {
  id        String  @id @default(cuid())
  menfessId String
  menfess   Menfess @relation(fields: [menfessId], references: [id])
  type      String // e.g., 'like', 'love', 'laugh'
  count     Int     @default(0)

  @@unique([menfessId, type]) // one row per menfessId + reaction type
}

model Comment {
  id        String   @id @default(cuid())
  menfessId String
  menfess   Menfess  @relation(fields: [menfessId], references: [id])
  author    String   @default("SipalingPenyamar")
  content   String
  createdAt DateTime @default(now())

  @@index([menfessId])
}
